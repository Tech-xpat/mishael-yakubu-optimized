# Supabase Configuration
# Project: mishael-personality (https://mmnsovgpmojjeqajbcfo.supabase.co)
# Get these from Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://mmnsovgpmojjeqajbcfo.supabase.co
