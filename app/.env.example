# Supabase Configuration (Auth)
# Get these from your Supabase project: https://supabase.com/dashboard/project/mmnsovgpmojjeqajbcfo/settings/api

VITE_SUPABASE_URL=https://mmnsovgpmojjeqajbcfo.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Resend Email Service Configuration
# Get your API key from https://resend.com
VITE_RESEND_API_KEY=your_resend_api_key_here

# Firebase Configuration (still used for Storage / Firestore if applicable)
# Get these values from your Firebase project console at https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Notes:
# 1. Copy this file to .env.local for local development
# 2. On Vercel, add the same variables in Project Settings → Environment Variables
# 3. Auth uses Supabase (empiredigitalsworldwide@gmail.com and letstalk2mishael@gmail.com are already created as admins)
# 4. Never commit the real .env.local or service role key
